# Copy this file to ".env" and fill in your values. The .env file is git-ignored.
# The app auto-loads .env at startup (settings.py). Real environment variables
# always take precedence over .env.

# Provider selection: "mock" (offline, free) or "checknumber" (live API).
VERIFIER_PROVIDER=checknumber

# Your checknumber.ai API key (from the dashboard). Keep this secret.
CHECKNUMBER_API_KEY=your_key_here

# Optional overrides (defaults shown):
# CHECKNUMBER_BASE_URL=https://api.checknumber.ai/v1
# DEFAULT_PHONE_REGION=US
